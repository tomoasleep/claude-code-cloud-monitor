{
  "name": "claude-code-cloud-monitor",
  "version": "0.1.0",
  "description": "Launch Claude Code cloud sessions from your terminal and monitor them through a GitHub issue comment",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cccm": "bin/cccm.js"
  },
  "files": [
    "bin",
    "dist",
    "plugin",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomoasleep/claude-code-cloud-monitor.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "node --test \"src/e2e/**/*.e2e.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.20.5",
    "emulate": "^0.14.0",
    "typescript": "^7.0.2"
  }
}
